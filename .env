# ============================================================
# Backend (Go) — nada daqui vai para o app
# ============================================================

# Connection string do Postgres do Supabase (Project Settings → Database).
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Validação do JWT emitido pelo Supabase Auth (internal/auth)
SUPABASE_JWKS_URL=https://SEU-PROJETO.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://SEU-PROJETO.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Usada só para gerar URL assinada de upload no Storage. Segredo.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=avatars

API_PORT=8080
WS_PORT=8081
LOG_LEVEL=info

# Analytics de servidor
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Push via Firebase Admin SDK. Caminho para o JSON da service account — fora do repositório. Em produção (Fly.io), passe como secret.
FIREBASE_SERVICE_ACCOUNT_JSON=./secrets/firebase-service-account.json

# ============================================================
# Build local
# ============================================================

# Versão do Go usada pelo docker-compose para construir a imagem.
# Preencha com a saída de `go version` (ex: 1.24).
GO_VERSION=1.26.5

# ============================================================
# Mobile — valores usados no build do app
# ============================================================

# 10.0.2.2 é o endereço do host visto de dentro do emulador Android.
API_BASE_URL=http://10.0.2.2:8080
WS_BASE_URL=ws://10.0.2.2:8081

# O app precisa da anon key para falar com o Supabase Auth (login Discord).
SUPABASE_ANON_KEY=

# ============================================================
# Supabase CLI
# ============================================================

# Senha do projeto, usada em `supabase db push`
SUPABASE_PASSWORD=
